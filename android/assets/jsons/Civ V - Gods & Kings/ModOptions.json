        // AssignStartingPlots:NormalizeStartLocation and NormalizeCityState
        "startNormalizerLikeCivV": true,
        // MapGenerator.lua GenerateCoasts: expansion_diceroll_table {4, 4}
        "coastExpansionDice": [4, 4],
        // AssignStartingPlots:PlaceOilInTheSea
        "seaDepositsOfLandResource": "Oil",
        // TerrainGenerator.lua and FeatureGenerator.lua
        "terrainGeneratorLikeCivV": true,
        "naturalWondersLikeCivV": true,
        "ancientRuinsLikeCivV": true
    },
