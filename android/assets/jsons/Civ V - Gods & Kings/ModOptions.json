{
    "isBaseRuleset": true,
    "constants": {
        // CvTreasury::CalculateUnitCost with the GlobalDefines UNIT_MAINTENANCE_GAME_MULTIPLIER 8 and UNIT_MAINTENANCE_GAME_EXPONENT_DIVISOR 7;
        // no unit is free (the handicaps have GoldFreeUnits 0)
        "unitMaintenanceFreeUnits": 0,
        "unitMaintenanceGameMultiplier": 8,
        "unitMaintenanceExponentDivisor": 7,
        // CvCity::GetJONSCultureThreshold
        "cultureCostLikeCivV": true,
        // CvTreasury::DoGold
        "treasuryNeverNegative": true,
        // CvPlayer::GetBuyPlotCost, CvCity::GetBuyPlotCost, CvCity::CanBuyPlot, CvCity::GetBuyablePlotList
        "plotAcquisitionLikeCivV": true,
        // CvPlot::changeAdjacentSight
        "sightBeyondRangeLikeCivV": true,
        // CvUnit::visibilityRange
        "minimumSightRange": 0,
        // CvUnit::currInterceptionProbability
        "airInterceptionChanceScalesWithHealth": true,
        // CvPlayer::GetUnhappinessFromOccupiedCities: UNHAPPINESS_PER_OCCUPIED_POPULATION, no flat term
        "annexedCityCitizenUnhappinessFactor": 1.34,
        "annexedCityFlatUnhappiness": 0,
        // CvUnitCombat::ApplyNuclearExplosionDamage: NUKE_NON_COMBAT_DEATH_THRESHOLD
        "nukeCivilianDeathDamage": 6,
        // CvUnit::GetScrapGold: DISBAND_UNIT_REFUND_PERCENT
        "disbandRefundPercent": 25,
        // CvGame::DoCacheMapScoreMod: 80 x 52, the standard world size
        "scoreBaseMapTiles": 4160,
        // CvUnitMovement::GetCostsForMove: HILLS_EXTRA_MOVEMENT
        "featureOnHillsExtraMovement": 1,
        // CvCityBuildings::GetSellBuildingRefund: BUILDING_SALE_DIVISOR
        "buildingSaleDivisor": 4,
        // CvPlayer::SetUnitUpgradeCostMod, CvUnit::upgradePrice: UNIT_UPGRADE_COST_DISCOUNT_MAX
        "unitUpgradeCostModsAreSummed": true,
        "unitUpgradeCostDiscountMax": -75,
        // CvTeam::DoMinorCivTech: MINOR_CIV_TECH_PERCENT
        "minorCivTechPercent": 40,
        // CvCity::doCheckProduction, CvCity::popOrder: MAXED_UNIT_GOLD_PERCENT, MAXED_BUILDING_GOLD_PERCENT
        "maxedUnitGoldPercent": 100,
        "maxedBuildingGoldPercent": 100,
        // CvCity::doTurn: CITY_HIT_POINTS_HEALED_PER_TURN plus capital and building defense
        "cityHealLikeCivV": true,
        // CvCity::DoSeedResourceDemandedCountdown, CvCity::DoTestResourceDemanded
        "resourceDemandLikeCivV": true,
        // CvMap.cpp CvLandmass::isLake: LAKE_MAX_AREA_SIZE
        "maxLakeSize": 9,
        // CvPlayer::createGreatGeneral: GREAT_GENERALS_THRESHOLD_INCREASE, and CvPlayer::recomputeGreatPeopleModifiers: COMBAT_EXPERIENCE_IN_BORDERS_PERCENT
        "greatGeneralThresholdLikeCivV": true,
        "greatGeneralPercentInBorders": 100,
        // CvUnit::CanWithdrawFromMelee: WITHDRAW_MOD_ENEMY_MOVES -20, WITHDRAW_MOD_BLOCKED_TILE -20
        "withdrawLikeCivV": true,
        // CvCity::canRangeStrikeAt
        "citiesCanBombardCities": false,
        // CvUnit::PerformCultureBomb: CULTURE_BOMB_MINOR_FRIENDSHIP_CHANGE
        "cityStateInfluenceChangeForTilesTaken": -50,
        "cityStateInfluenceOncePerTilesTaken": true,
        // AssignStartingPlots:NormalizeStartLocation and NormalizeCityState
        "startNormalizerLikeCivV": true,
        // MapGenerator.lua GenerateCoasts: expansion_diceroll_table {4, 4}
        "coastExpansionDice": [4, 4],
        // AssignStartingPlots:PlaceOilInTheSea
        "seaDepositsOfLandResource": "Oil",
        // TerrainGenerator.lua and FeatureGenerator.lua
        "terrainGeneratorLikeCivV": true,
        "naturalWondersLikeCivV": true,
        "ancientRuinsLikeCivV": true
    },
}
