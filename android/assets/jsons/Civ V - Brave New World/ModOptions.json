{
    "isBaseRuleset": true,
    // Score values of Brave New World (GlobalDefines.xml SCORE_*_MULTIPLIER)
    "constants": {
        "scoreFromPopulation": 4,
        "scoreFromWonders": 25,
        "scoreFromGreatWorks": 4,
        // CvMinorCivAI::CalculateBullyMetric: up to 75 for the military rank, up to 125 for the military near the City-State
        "tributeGlobalModifier": 75,
        "tributeLocalModifier": 125,
        // CvTreasury::CalculateUnitCost: GlobalDefines UNIT_MAINTENANCE_GAME_MULTIPLIER 8 and UNIT_MAINTENANCE_GAME_EXPONENT_DIVISOR 7;
        // no unit is free (the handicaps have GoldFreeUnits 0)
        "unitMaintenanceFreeUnits": 0,
        "unitMaintenanceGameMultiplier": 8,
        "unitMaintenanceExponentDivisor": 7,
        // CvCity::GetJONSCultureThreshold
        "cultureCostLikeCivV": true,
        // CvTreasury::DoGold
        "treasuryNeverNegative": true,
        // CvUnitMovement::GetCostsForMove: HILLS_EXTRA_MOVEMENT
        "featureOnHillsExtraMovement": 1,
        // AssignStartingPlots:NormalizeStartLocation and NormalizeCityState
        "startNormalizerLikeCivV": true,
        // MapGenerator.lua GenerateCoasts: expansion_diceroll_table {4, 4}
        "coastExpansionDice": [4, 4],
        // AssignStartingPlots:PlaceOilInTheSea
        "seaDepositsOfLandResource": "Oil",
        // TerrainGenerator.lua and FeatureGenerator.lua
        "terrainGeneratorLikeCivV": true,
        // AssignStartingPlots.lua of Brave New World (the Gods & Kings one differs: no cocoa, other counts)
        "luxuryPlacementLikeCivV": true,
        // AssignStartingPlots:BalanceAndAssign of Brave New World (it differs from the Gods & Kings one by the civs placed first)
        "startAssignmentLikeCivV": true,
        // AddExtraBonusesToHillsRegions, PlaceSexyBonusAtCivStarts, AddModernMinorStrategicsToCityStates, the strategic top-ups, FixSugarJungles
        "resourceExtrasLikeCivV": true,
        "naturalWondersLikeCivV": true,
        "ancientRuinsLikeCivV": true
    },
}
